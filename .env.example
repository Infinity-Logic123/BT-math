# ── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"
# Public base URL used for canonical URLs, sitemap, emails.
# Leave empty to auto-detect from request headers (fine for most deployments).
NEXT_PUBLIC_SITE_URL=""

# ── Bootstrap admin (created by `npm run db:seed`) ──────────────────────────
ADMIN_NAME="BT Admin"
ADMIN_EMAIL="admin@thebtmath.com"
ADMIN_PASSWORD="ChangeMe!2026"

# Seed demo taxonomy (classes/subjects/chapters). Set "false" for production.
SEED_DEMO_DATA="true"

# ── YouTube (optional; server-side only, never exposed to the browser) ──────
# YouTube Data API v3 key — https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=""
# The BT Math channel ID (UC...) — can also be set in Admin → Settings
YOUTUBE_CHANNEL_ID=""

# Auto-sync: pull new channel uploads into drafts automatically.
# In-app scheduler (VPS/Docker/this sandbox). Set "false" on serverless and
# use CRON_SECRET + an external cron hitting POST /api/cron/youtube-sync.
YOUTUBE_AUTO_SYNC="true"
YOUTUBE_SYNC_INTERVAL_MINUTES="15"

# Secret for the cron endpoint POST /api/cron/youtube-sync (x-cron-secret header).
CRON_SECRET=""

# ── Email / SMTP (optional). Without it: accounts are auto-verified on
# registration, and password reset is handled via Admin → Students →
# "Set temporary password". With SMTP configured: verification + reset emails
# are sent automatically. ─────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="The BT Math <no-reply@thebtmath.com>"
